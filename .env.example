# Keep real credentials only in a local .env file. This example is safe to commit.
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# groq is quickest for the interactive MVP; gemini and openrouter are fallbacks.
AGENT_PROVIDER=groq
VOICE_PORT=8787
